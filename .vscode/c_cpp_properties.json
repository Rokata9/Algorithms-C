{
  "version": 4,
  "configurations": [
    {
      "name": "macOS",
      "includePath": [
        "${workspaceFolder}",
        "${workspaceFolder}/**"
      ],
      "defines": [],
      "compilerPath": "/usr/bin/clang",
      "cStandard": "c17",
      "intelliSenseMode": "macos-clang-arm64",
      "browse": {
